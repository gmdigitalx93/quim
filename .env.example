# Clave de la API de Anthropic (obligatoria)
ANTHROPIC_API_KEY=sk-ant-...

# --- Ajustes opcionales (todos tienen valores por defecto) ---
# Palabras que activan el asistente, separadas por coma
VOZ_PALABRAS_CLAVE=oye claude,oye clod,oye cloud,oye claudio

# Modelo de Claude
VOZ_MODELO=claude-opus-5
# low | medium | high | xhigh | max  (low = respuestas más rápidas)
VOZ_ESFUERZO=low
VOZ_IDIOMA=es

# Motor de transcripción: whisper | vosk
VOZ_STT=whisper
# tiny | base | small | medium  (small = buen equilibrio en CPU)
VOZ_WHISPER_MODELO=small

# Motor de voz: auto | say | piper | espeak | powershell | pyttsx3
VOZ_TTS=auto
VOZ_TTS_VOZ=
VOZ_PIPER_MODELO=modelos/es_ES-sharvard-medium.onnx

# Ruta al modelo Vosk en español (para la palabra clave)
VOZ_VOSK_MODELO=modelos/vosk-es

# Segundos de silencio que dan por terminada tu frase
VOZ_SILENCIO=1.0
# Segundos que sigue escuchando tras responder (conversación continua)
VOZ_SEGUIMIENTO=8.0
